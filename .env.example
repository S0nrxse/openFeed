# Core application
TZ=UTC
OPENFEED_BIND_IP=127.0.0.1
OPENFEED_PORT=8060
# The address people open OpenFeed at. When it is set, sign-in moves to it (cookies, passkeys
# and OIDC callbacks belong there); left unset, sign-in stays wherever OpenFeed was opened.
OPENFEED_PUBLIC_URL=http://localhost:8060
# AGPL-3.0 section 13: where network users can get the source you are running.
OPENFEED_SOURCE_URL=https://github.com/S0nrxse/openFeed
OPENFEED_DATA_DIR=./data
# The app image. Leave unset to build it from this checkout (./deploy.sh up --build), or use
# a prebuilt release, for example ghcr.io/s0nrxse/openfeed:0.2.0-alpha, and skip --build.
# OPENFEED_IMAGE=ghcr.io/s0nrxse/openfeed:0.2.0-alpha
OPENFEED_SECRET_KEY=replace-with-a-random-secret

# Main database and cache
POSTGRES_DB=openfeed
POSTGRES_USER=openfeed
POSTGRES_PASSWORD=replace-with-a-random-password
REDIS_URL=redis://openfeed-redis:6379/0

# Authentication (disabled by default). docs/accounts.md has the details.
#   disabled        everyone is the one local user (a single person on a trusted network)
#   accounts        built-in accounts: username + password, optional 2FA; sign-in required.
#                   The first visit goes to /setup, which asks for a one-time code printed
#                   in the server log: docker compose logs openfeed-app | grep "setup code"
#   authentik_oidc  sign in through the OIDC provider below (unchanged for existing installs)
OPENFEED_AUTH_MODE=disabled
OPENFEED_REQUIRE_LOGIN=false
OPENFEED_REQUIRED_GROUP=
OPENFEED_ADMIN_GROUPS=
OPENFEED_SESSION_SECRET=
OPENFEED_SESSION_COOKIE=openfeed_session
# Password sign-in: auto (default) = on in accounts mode, off in authentik_oidc mode.
# Set true in authentik_oidc mode to offer both the provider and a password form.
# OPENFEED_PASSWORD_SIGNIN=auto
# A fixed first-run setup code instead of a generated one (for automated deploys).
# OPENFEED_SETUP_CODE=
# Reverse proxies whose X-Forwarded-For is trusted for sign-in rate limits, and whose
# OPENFEED_TRUSTED_HEADER is believed (IPs or CIDRs, comma-separated). The client address
# is only ever hashed, never stored.
# OPENFEED_TRUSTED_PROXIES=172.16.0.0/12
# "Confirm it's you" lasts this long before sensitive changes ask again (default 10 min).
# OPENFEED_REAUTH_SECONDS=600
# A session ends after this long without use (default 7 days)...
# OPENFEED_SESSION_IDLE_SECONDS=604800
# ...and in any case this long after sign-in (default 30 days).
# OPENFEED_AUTH_SESSION_TTL_SECONDS=2592000
# How long a session may keep exercising admin rights after the login that granted
# them (default 24h). 0 keeps admin rights for the whole session lifetime.
# OPENFEED_ADMIN_SESSION_SECONDS=86400
# Force the session cookie's Secure flag: auto (default) enables it only over https,
# or set true/false explicitly.
# OPENFEED_COOKIE_SECURE=auto
OPENFEED_RSS_GUID_NAMESPACE=openfeed
OPENFEED_OIDC_ISSUER=
OPENFEED_OIDC_DISCOVERY_URL=
OPENFEED_OIDC_BACKCHANNEL_BASE_URL=
OPENFEED_OIDC_CLIENT_ID=
OPENFEED_OIDC_CLIENT_SECRET=
OPENFEED_OIDC_REDIRECT_URI=
OPENFEED_OIDC_SCOPE=openid email profile
# The name on the sign-in button for this provider in accounts mode.
# OPENFEED_OIDC_NAME=Authentik
# With the single provider above: create an account for every new person it lets through
# (always; the default in authentik_oidc mode) or only when registration allows (registration;
# the default in accounts mode). Also OPENFEED_OIDC_TOKEN_AUTH and OPENFEED_OIDC_GROUPS_CLAIM.
# OPENFEED_OIDC_CREATE_ACCOUNTS=

# More OIDC providers (Pocket ID, Authelia, Keycloak, Zitadel, Google, ...). List their names
# (letters, digits, - and _), then set each one's values. The single provider above is
# called "authentik"; listing it keeps those values as its defaults. With Docker, put the
# per-provider lines (and their secrets) in signin.env next to compose.yml.
# Redirect URI to register at each provider: <OPENFEED_PUBLIC_URL>/auth/oidc/<name>/callback
# (the "authentik" provider keeps /auth/callback).
# OPENFEED_OIDC_PROVIDERS=authentik,pocketid
# OPENFEED_OIDC_POCKETID_ISSUER=https://id.example.com
# OPENFEED_OIDC_POCKETID_CLIENT_ID=
# OPENFEED_OIDC_POCKETID_CLIENT_SECRET=
# OPENFEED_OIDC_POCKETID_DISPLAY_NAME=Pocket ID
# OPENFEED_OIDC_POCKETID_SCOPES=openid email profile groups
# Groups at this provider that make someone an admin, or that everyone must have:
# OPENFEED_OIDC_POCKETID_ADMIN_GROUPS=openfeed-admins
# OPENFEED_OIDC_POCKETID_REQUIRED_GROUP=
# registration (default: open sign-up or an invite link) or always:
# OPENFEED_OIDC_POCKETID_CREATE_ACCOUNTS=registration
# Optional: _GROUPS_CLAIM (default groups), _REDIRECT_URI, _DISCOVERY_URL,
# _BACKCHANNEL_BASE_URL, _TOKEN_AUTH (client_secret_basic, client_secret_post or none).

# Passkeys: auto (default) = on wherever password sign-in is on and OPENFEED_PUBLIC_URL is
# https on a domain name (or localhost); on = also in authentik_oidc mode; off.
# OPENFEED_PASSKEYS=auto

# Trusted header from a forward-auth proxy (Authentik outpost, Authelia, oauth2-proxy,
# Cloudflare Access). Believed only from OPENFEED_TRUSTED_PROXIES, stripped from anyone else.
# OPENFEED_TRUSTED_HEADER=Remote-User
# OPENFEED_TRUSTED_HEADER_GROUPS=Remote-Groups
# OPENFEED_TRUSTED_HEADER_NAME=Remote-Name
# What the pages call it ("Confirm with ..."):
# OPENFEED_TRUSTED_HEADER_LABEL=your sign-in proxy
# registration (default) or always: make an account for every name the proxy sends.
# OPENFEED_TRUSTED_HEADER_CREATE_ACCOUNTS=registration
# Defaults to OPENFEED_ADMIN_GROUPS:
# OPENFEED_TRUSTED_HEADER_ADMIN_GROUPS=
# Sign out at the proxy too, or it signs you straight back in:
# OPENFEED_TRUSTED_HEADER_LOGOUT_URL=https://auth.example.com/logout

# Invidious
INVIDIOUS_BIND_IP=127.0.0.1
INVIDIOUS_PORT=8061
INVIDIOUS_DOMAIN=localhost
INVIDIOUS_BASE_URL=http://openfeed-invidious:3000
INVIDIOUS_PUBLIC_URL=http://localhost:8061
INVIDIOUS_DB_NAME=invidious
INVIDIOUS_DB_USER=invidious
INVIDIOUS_DB_PASSWORD=replace-with-a-random-password
INVIDIOUS_HMAC_KEY=replace-with-a-random-secret
INVIDIOUS_COMPANION_KEY=replace-with-a-random-16-character-key


# Background processing
SYNC_INTERVAL_SECONDS=1800
# Direct YouTube RSS polling by the worker (code defaults shown).
# RSS_POLL_LIMIT=100
# RSS_POLL_TTL_SECONDS=3600
ENRICH_AFTER_SYNC_LIMIT=40
ENRICHMENT_TIMEOUT_SECONDS=12
DISCOVER_AFTER_SYNC_LIMIT=3
DISCOVER_RELATED_PER_VIDEO=6

# Optional search/vector profiles
TYPESENSE_API_KEY=replace-with-a-random-secret

# Third-party players (see PRIVACY.md). Both send the viewer's browser to someone else,
# so both are off by default. Allowing one here only makes it available: each user still
# has to turn it on under Settings > Privacy, and the player offers it as a "Play from"
# button after the private sources fail. Nothing falls back to them automatically.
# "youtube" allows the youtube-nocookie.com embed; "off" does not.
OPENFEED_PLAYBACK_FALLBACK=off
# Comma-separated public Invidious instances offered to users (each still opts in).
OPENFEED_INVIDIOUS_FALLBACKS=
# true lets users add public Invidious instances of their own.
# These three, and the RYD/SponsorBlock/DeArrow switches, can be changed in Admin -> Server.
OPENFEED_ALLOW_PUBLIC_INSTANCES=false

# Privacy (see PRIVACY.md).
# Send every server-side request to YouTube and third parties (RSS, oEmbed, yt-dlp,
# captions, live chat, Return YouTube Dislike, SponsorBlock, DeArrow, public-instance
# probes) through this proxy: http://, https://, socks5:// or socks5h:// (Tor:
# socks5h://127.0.0.1:9050). Calls to your own Invidious never use it; set Invidious'
# own http_proxy for those. Empty sends them directly.
OPENFEED_OUTBOUND_PROXY=
# Debugging only: put client IP addresses and full URLs (search terms included) back into
# the access log and name search terms in error logs.
OPENFEED_LOG_CLIENT_DETAILS=false
# Seconds to wait when probing whether a source can serve a video.
OPENFEED_PLAYBACK_PROBE_TIMEOUT=4

# yt-dlp fallback media backend.
# Invidious stays primary for browsing, search, channels, comments and normal playback.
# yt-dlp is used only when Invidious cannot produce a usable stream, and for downloads
# above 720p, which YouTube publishes as separate video and audio tracks that ffmpeg
# has to mux back together.
OPENFEED_YTDLP_ENABLED=true
# Offer the direct-stream player as a rung in the playback ladder. Set false to keep
# yt-dlp for downloads only.
OPENFEED_YTDLP_PLAYBACK=true
# Hard timeout for a metadata extraction, in seconds.
OPENFEED_YTDLP_TIMEOUT=90
# Extracted stream URLs are signed and expire. Keep this short — it exists to collapse a
# burst of requests for one video, not to hold a URL.
OPENFEED_YTDLP_CACHE_SECONDS=240
# Optional Netscape cookies file, if YouTube demands sign-in for some videos. Supply the
# file yourself and mount it into the container; its contents are never logged.
OPENFEED_YTDLP_COOKIES_FILE=
# Extra yt-dlp flags. This is the usual fix when YouTube changes its player, e.g.
# OPENFEED_YTDLP_EXTRA_ARGS=--extractor-args youtube:player_client=web_safari
# NOTE: --exec*, --load-info* and --config-locations are blocked/ignored (arbitrary command/file risk).
OPENFEED_YTDLP_EXTRA_ARGS=
# Where downloads are written. Bind-mounted to ./data/downloads so anything you keep
# on the server survives a restart and is browsable outside the app.
OPENFEED_DOWNLOAD_DIR=/data/downloads
# Seconds a browser-destined download lingers before being swept (default 6 hours).
# Downloads you chose to keep on the server are never swept.
OPENFEED_DOWNLOAD_RETENTION=21600
# How many merges may run at once. Each one is a download plus an ffmpeg mux.
OPENFEED_DOWNLOAD_CONCURRENCY=2
# Ceiling for the resolutions offered in the download picker.
OPENFEED_DOWNLOAD_MAX_HEIGHT=2160
# DeArrow community titles and thumbnails. Each user still opts in under Settings ->
# Integrations, where the privacy trade is stated; false makes it unavailable to everyone.
OPENFEED_DEARROW_ENABLED=true
# Kill a download that has not moved for this many seconds (0 disables the watchdog).
OPENFEED_DOWNLOAD_STALL_SECONDS=240

# Shared installs (sign-in on). Admin -> Server changes all of these in the app; the values
# here are the defaults until an admin saves something there.
# May members download at all (admins always can)?
OPENFEED_MEMBERS_MAY_DOWNLOAD=true
# Storage per member for downloads kept on the server, in MB, per account. 0 = no limit.
OPENFEED_DOWNLOAD_QUOTA_MB=0
# Largest Takeout archive accepted, in MB (at most 2048).
OPENFEED_TAKEOUT_MAX_MB=2048
# Per-account rate limits (admins exempt, nothing is limited with sign-in off). 0 turns one off.
# Searches per 10 minutes; channel, playlist, comment and watch pages per 10 minutes;
# playlist imports per hour; Takeout imports per day; downloads started per hour; OPML
# imports per hour.
OPENFEED_RATE_LIMIT_SEARCH=120
OPENFEED_RATE_LIMIT_INVIDIOUS=600
OPENFEED_RATE_LIMIT_PLAYLIST_IMPORT=10
OPENFEED_RATE_LIMIT_TAKEOUT_IMPORT=5
OPENFEED_RATE_LIMIT_DOWNLOADS=30
OPENFEED_RATE_LIMIT_OPML_IMPORT=10

# Runtime hardening (read by compose.yml)
# Run the app container as this host uid/gid so it matches the owner of
# ./data/downloads; leave unset to use the image's own openfeed user (10000).
OPENFEED_UID=
OPENFEED_GID=
# Container ceilings against a runaway 4K remux or fork bomb.
OPENFEED_APP_MEM_LIMIT=4g
OPENFEED_APP_PIDS_LIMIT=256
OPENFEED_WORKER_MEM_LIMIT=1g
OPENFEED_WORKER_PIDS_LIMIT=128
# Retry YouTube player calls before giving up (helps with intermittent "no formats").
COMPANION_RETRY_ENABLED=true
COMPANION_RETRY_TIMES=3
COMPANION_RETRY_DEBOUNCE_MS=500
COMPANION_RETRY_MULTIPLIER=2
# Leave UMP off. Turning it on makes /companion/videoplayback return an empty
# vnd.yt-ump body, which the browser reports as "format is not supported".
COMPANION_UMP=false
# Route the companion's YouTube traffic through a different egress (e.g. a residential
# proxy). Attestation is refused from datacenter and VPN IPs, so this is the real fix
# when the host is behind a VPN.
COMPANION_PROXY=
# A logged-in YouTube cookie header also restores stream formats. Treat as a secret and
# set it in .env only - never commit it.
COMPANION_YOUTUBE_COOKIES=
