# Core application
TZ=UTC
OPENFEED_BIND_IP=127.0.0.1
OPENFEED_PORT=8060
OPENFEED_PUBLIC_URL=http://localhost:8060
# AGPL-3.0 section 13: where network users can get the source you are running.
OPENFEED_SOURCE_URL=https://github.com/S0nrxse/openFeed
OPENFEED_DATA_DIR=./data
OPENFEED_SECRET_KEY=replace-with-a-random-secret

# Main database and cache
POSTGRES_DB=openfeed
POSTGRES_USER=openfeed
POSTGRES_PASSWORD=replace-with-a-random-password
REDIS_URL=redis://openfeed-redis:6379/0

# Authentication (disabled by default)
OPENFEED_AUTH_MODE=disabled
OPENFEED_REQUIRE_LOGIN=false
OPENFEED_REQUIRED_GROUP=
OPENFEED_ADMIN_GROUPS=
OPENFEED_SESSION_SECRET=
OPENFEED_SESSION_COOKIE=openfeed_session
OPENFEED_RSS_GUID_NAMESPACE=openfeed
OPENFEED_OIDC_ISSUER=
OPENFEED_OIDC_DISCOVERY_URL=
OPENFEED_OIDC_BACKCHANNEL_BASE_URL=
OPENFEED_OIDC_CLIENT_ID=
OPENFEED_OIDC_CLIENT_SECRET=
OPENFEED_OIDC_REDIRECT_URI=
OPENFEED_OIDC_SCOPE=openid email profile

# FreshRSS
FRESHRSS_BIND_IP=127.0.0.1
FRESHRSS_PORT=8050
FRESHRSS_PUBLIC_URL=http://localhost:8050
FRESHRSS_BASE_URL=http://freshrss
FRESHRSS_CRON_MIN=13,43
FRESHRSS_DATA_DIR=./data/freshrss/data
FRESHRSS_EXTENSIONS_DIR=./data/freshrss/extensions
FRESHRSS_DB_PASSWORD=replace-with-a-random-password
FRESHRSS_ADMIN_USER=admin
FRESHRSS_ADMIN_API_PASSWORD=replace-with-a-random-password
FRESHRSS_ADMIN_EMAIL=admin@example.com
FRESHRSS_ADMIN_PASSWORD=replace-with-a-random-password
FRESHRSS_USERNAME=admin
FRESHRSS_API_PASSWORD=replace-with-a-random-password
FRESHRSS_READING_LIST_LIMIT=250
FRESHRSS_OIDC_ENABLED=0
FRESHRSS_OIDC_PROVIDER_METADATA_URL=
FRESHRSS_OIDC_CLIENT_ID=
FRESHRSS_OIDC_CLIENT_SECRET=
FRESHRSS_OIDC_CLIENT_CRYPTO_KEY=

# Invidious
INVIDIOUS_BIND_IP=127.0.0.1
INVIDIOUS_PORT=8061
INVIDIOUS_DOMAIN=localhost
INVIDIOUS_BASE_URL=http://openfeed-invidious:3000
INVIDIOUS_PUBLIC_URL=http://localhost:8061
INVIDIOUS_DB_NAME=invidious
INVIDIOUS_DB_USER=invidious
INVIDIOUS_DB_PASSWORD=replace-with-a-random-password
INVIDIOUS_HMAC_KEY=replace-with-a-random-secret
INVIDIOUS_COMPANION_KEY=replace-with-a-random-16-character-key

# Gorse recommendations
GORSE_POSTGRES_DB=gorse
GORSE_POSTGRES_USER=gorse
GORSE_POSTGRES_PASSWORD=replace-with-a-random-password
GORSE_BASE_URL=http://openfeed-gorse:8088
GORSE_SERVER_API_KEY=replace-with-a-random-secret
GORSE_ADMIN_API_KEY=replace-with-a-random-secret
GORSE_DASHBOARD_USER_NAME=admin
GORSE_DASHBOARD_PASSWORD=replace-with-a-random-password

# Background processing
SYNC_INTERVAL_SECONDS=1800
ENRICH_AFTER_SYNC_LIMIT=5
ENRICHMENT_TIMEOUT_SECONDS=12
DISCOVER_AFTER_SYNC_LIMIT=3
DISCOVER_RELATED_PER_VIDEO=6

# Optional search/vector profiles
TYPESENSE_API_KEY=replace-with-a-random-secret

# Playback fallback and Invidious companion tuning
# Fallback used when the local Invidious cannot produce streams: "youtube" or "off".
OPENFEED_PLAYBACK_FALLBACK=youtube
# Comma-separated public Invidious instances offered as additional fallbacks.
OPENFEED_INVIDIOUS_FALLBACKS=
# Seconds to wait when probing whether a source can serve a video.
OPENFEED_PLAYBACK_PROBE_TIMEOUT=4
# Retry YouTube player calls before giving up (helps with intermittent "no formats").
COMPANION_RETRY_ENABLED=true
COMPANION_RETRY_TIMES=3
COMPANION_RETRY_DEBOUNCE_MS=500
COMPANION_RETRY_MULTIPLIER=2
# Leave UMP off. Turning it on makes /companion/videoplayback return an empty
# vnd.yt-ump body, which the browser reports as "format is not supported".
COMPANION_UMP=false
# Route the companion's YouTube traffic through a different egress (e.g. a residential
# proxy). Attestation is refused from datacenter and VPN IPs, so this is the real fix
# when the host is behind a VPN.
COMPANION_PROXY=
# A logged-in YouTube cookie header also restores stream formats. Treat as a secret and
# set it in .env only - never commit it.
COMPANION_YOUTUBE_COOKIES=
